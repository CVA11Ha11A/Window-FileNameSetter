<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <system:String x:Key="WindowTitle">批量重命名工具</system:String>
    <system:String x:Key="TargetFolder">目标文件夹:</system:String>
    <system:String x:Key="BrowseFolder">浏览</system:String>
    <system:String x:Key="DeepSearch">包含子文件夹</system:String>
    <system:String x:Key="ExtensionFilter">扩展名筛选</system:String>
    <system:String x:Key="TargetFiles">目标文件</system:String>
    <system:String x:Key="SelectAll">全选</system:String>
    <system:String x:Key="CurrentName">当前名称</system:String>
    <system:String x:Key="PreviewName">新名称 (预览)</system:String>
    <system:String x:Key="FilePath">路径</system:String>
    <system:String x:Key="Prefix">前缀:</system:String>
    <system:String x:Key="Suffix">后缀:</system:String>
    <system:String x:Key="ReplaceWord">替换:</system:String>
    <system:String x:Key="ExecuteRename">执行重命名</system:String>

    <system:String x:Key="Msg_NoFilesSelected">未选择任何文件。</system:String>
    <system:String x:Key="Msg_Notice">提示</system:String>
    <system:String x:Key="Msg_ConfirmRename">您确定要重命名选中的 {0} 个文件吗？</system:String>
    <system:String x:Key="Msg_ExecuteRenameTitle">执行重命名</system:String>
    <system:String x:Key="Msg_RenameResult">任务完成&#x0a;- 成功: {0} 个&#x0a;- 失败或跳过: {1} 个</system:String>
    <system:String x:Key="Msg_Complete">完成</system:String>
    <system:String x:Key="Msg_NoPermission">您没有权限访问此文件夹。</system:String>
    <system:String x:Key="Msg_PermissionError">权限错误</system:String>
    <system:String x:Key="Msg_ReadError">读取文件时发生错误: {0}</system:String>
    <system:String x:Key="Msg_Error">错误</system:String>

    <system:String x:Key="Msg_NoExtension">[无扩展名]</system:String>
    <system:String x:Key="Msg_SelectFolderTitle">请选择包含要重命名文件的文件夹。</system:String>
</ResourceDictionary>