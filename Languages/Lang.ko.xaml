<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:String x:Key="WindowTitle">파일 이름 일괄 변경기</system:String>
    <system:String x:Key="TargetFolder">대상 폴더:</system:String>
    <system:String x:Key="BrowseFolder">폴더 찾기</system:String>
    <system:String x:Key="DeepSearch">하위 폴더 포함 (딥 서치)</system:String>
    <system:String x:Key="ExtensionFilter">확장자 필터</system:String>
    <system:String x:Key="TargetFiles">변경 대상 파일</system:String>
    <system:String x:Key="SelectAll">전체 선택</system:String>
    <system:String x:Key="CurrentName">현재 이름</system:String>
    <system:String x:Key="PreviewName">변경될 이름 (미리보기)</system:String>
    <system:String x:Key="FilePath">경로</system:String>
    <system:String x:Key="Prefix">앞에 붙이기:</system:String>
    <system:String x:Key="Suffix">뒤에 붙이기:</system:String>
    <system:String x:Key="ReplaceWord">단어 변경:</system:String>
    <system:String x:Key="ExecuteRename">이름 변경 실행</system:String>
</ResourceDictionary>